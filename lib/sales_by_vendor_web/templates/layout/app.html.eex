<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Bizzy</title>
    <link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/app.css") %>"/>
    <script type="application/javascript">

      // CAN REFACTOR THE FUNCTIONS BELOW AFTER DISCOVERING THESE BUILT-IN JS FUNCTIONS: 
      // d.getUTCMonth() 
      // d.getUTCDate() 
      // d.getUTCFullYear() 
      // ...

      function day_ordinal(dayNumber) {
        var str_values = ["th", "st", "nd", "rd"];
        var values = dayNumber % 100;
        var dayOrdinal = dayNumber + (str_values[(values - 20) % 10] || str_values[values] || str_values[0])
      
        return dayOrdinal
      }

      function extract_date_time(date) {
        if (date === null) return
        var d = new Date(date.toString()) // 2019-02-11T21:10:31 ->
        var dStr = d.toString() // Mon Feb 11 2019 21:10:31 GMT-0500 (Eastern Standard Time)
        var n = dStr.lastIndexOf(":")
        var dStrUtc = dStr.substring(0, n + 4) + "GMT" // Mon Feb 11 2019 21:10:31 GMT
        var dLocal = new Date(dStrUtc) // Mon Feb 11 2019 16:10:31 GMT-0500 (Eastern Standard Time)
        var time = dLocal.toLocaleTimeString() // 4:10:31 PM
        dLocal = dLocal.toLocaleDateString() // 2/11/2019
      
        // now parse it
        var parts = dLocal.split('/')
        var month = parts[0]
        var monthName = month_name(month)
        var day = parts[1]
        var dayOrdinal = day_ordinal(day)
        var year = parts[2]
      
        return {
          monthName: monthName, 
          dayOrdinal: dayOrdinal,
          year: year,  
          time: time
        }
      }

      function getLocalTime() {
        var now = new Date();
    
        return now;
      }
    
      function long_to_short_date_time(date_time) { // "Wed, 06 Mar 2019 18:30:00 GMT" -> "2019-3-06 00:00:00"
        var dateTimeParts = date_time.split(" ")
        var day = dateTimeParts[1]
        var month = short_to_month_number(dateTimeParts[2])
        var year = dateTimeParts[3]
        var time = dateTimeParts[4]
        var date_time = `${year}-${month}-${day} 00:00:00`
        return date_time
      }
    
      function long_to_short_date_time_2(date_time) { // "Wed, 06 Mar 2019 18:30:00 GMT" -> "2019-3-06 18:30:00"
        var dateTimeParts = date_time.split(" ")
        var day = dateTimeParts[1]
        var month = short_to_month_number(dateTimeParts[2])
        var year = dateTimeParts[3]
        var time = dateTimeParts[4]
        var date_time = `${year}-${month}-${day} ${time}`
        return date_time
      }
          
      function long_to_short_date_time_3(date_time) { // "Wed, 06 Mar 2019 18:30:00 GMT" -> "2019-3-06 00:00:00"
        var dateTimeParts = date_time.split(" ")
        var day = dateTimeParts[1]
        var month = short_to_month_number(dateTimeParts[2])
        var year = dateTimeParts[3]
        var time = dateTimeParts[4]
        var date_time = `${year}-${month}-${day} 23:59:59`
        return date_time
      }

      function mon_to_sun(now) {
        var s = ""
        var e = ""

        var dayOfWeek = now.getDay()

        switch(dayOfWeek) { // 0 is Sunday and 6 is Saturday
          case 0:
            now.setDate(now.getDate() - 6) // Six days ago Monday 
            break
          case 1:                          // Monday
            break
          case 2:
            now.setDate(now.getDate() - 1) // Yesterday Monday 
            break
          case 3:
            now.setDate(now.getDate() - 2) // Two days ago Monday
            break
          case 4:
            now.setDate(now.getDate() - 3) // Three days ago Monday
            break
          case 5:
            now.setDate(now.getDate() - 4) // Four days ago Monday
            break
          case 6:
            now.setDate(now.getDate() - 5) // Five days ago Monday
            break
          default:
            // none 
            break
        }
  
        return now
      }

      function month_end_date_time(month, year) {
        var d = new Date(year, month, 0)

        return d
      }

      function month_name(monthNumber) {
        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
        var monthName = monthNames[monthNumber - 1]
  
        return monthName
      }

      function month_start_date_time(month, year) {
        var d = new Date(year, month - 1, 1)

        return d
      }

      function short_to_month_number(short) {
        const months = {
          'Jan': 1, 
          'Feb': 2, 
          'Mar': 3, 
          'Apr': 4, 
          'May': 5, 
          'Jun': 6, 
          'Jul': 7, 
          'Aug': 8, 
          'Sep': 9, 
          'Oct': 10, 
          'Nov': 11, 
          'Dec': 12}

        return months[short]
      }

      function yesterday(now) {
        now.setDate(now.getDate() - 1)
        
        return now
      }

    </script>
  </head>
  <body>
    <header>
      <section class="container">
        <nav role="navigation">
          <ul>
            <!-- <li><a href="https://hexdocs.pm/phoenix/overview.html">Get Started</a></li> -->
            <li>
              <%= if @current_user do %>
                <%= @current_user.username %>
                <%= link "Log out",
                    to: Routes.session_path(@conn, :delete, @current_user), 
                    method: "delete" %>
              <% else %>
                <%= link "Log in", to: Routes.session_path(@conn, :new) %>
              <% end %>
              <%= link "Register", to: Routes.user_path(@conn, :new) %>
            </li>
          </ul>
        </nav>
        <a href="http://phoenixframework.org/" class="phx-logo">
          <!-- <img src="<%= Routes.static_path(@conn, "/images/phoenix.png") %>" alt="Phoenix Framework Logo"/> -->
        </a>
      </section>
    </header>
    <main role="main" class="container">
      <p class="alert alert-info" role="alert"><%= get_flash(@conn, :info) %></p>
      <p class="alert alert-danger" role="alert"><%= get_flash(@conn, :error) %></p>
      <%= render @view_module, @view_template, assigns %>
    </main>
    <a href="/dashboard">HOME</a>
    <script type="text/javascript" src="<%= Routes.static_path(@conn, "/js/app.js") %>"></script>
  </body>
</html>
