<div class="dashboard">
<h1>Dashboard</h1>
<%= if @current_user do %>
  <div class="row">
    Grand total:&nbsp;<span id="grandTotal"><%= @grand_total %></span>
  </div>
  <div class="row">
    Commission:&nbsp;<span id="commission">&nbsp;</span>
  </div>
  <div class="row">
    * Total does not include monthly license fee expense.
  </div>
  <div class="row">
    <input id="commissionRate" type="text" width="21%" placeholder="Enter 18 to calculate 18%" />%
  </div>
  <div class="row">
    <button id="calculateCommissionButton" type="submit">Calculate</button>
  </div>
<% end %>
</div>